# The node kernel's options on top of libkrunfw's config-libkrunfw_aarch64.
# build.sh replaces the config's lines for these symbols with these lines.

# Transparent huge pages, so that the node's KVM can map pod VM memory in
# 2 MiB blocks. "always", because libkrun does not madvise the RAM of a
# cold-booted VM.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y

# Conntrack netlink, which kube-proxy needs to clear stale UDP entries.
CONFIG_NF_CT_NETLINK=y
