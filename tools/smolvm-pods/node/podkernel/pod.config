# Options added to libkrunfw's own config (config-libkrunfw_aarch64) for the pod VMs' kernel.
#
# Istio's istio-init container sets up traffic redirection with iptables, inside the pod. On a VM pod that is the VM's own
# kernel, and the stock one cannot add the rules: iptables-nft says "Extension REDIRECT revision 0 not supported" and
# "Extension owner is not supported". The rules of the sidecar's default REDIRECT mode need these two:
#   -m owner --uid-owner 1337 / --gid-owner 1337   so that Envoy's own connections are not redirected back to it
#   -j REDIRECT --to-ports 15001 / 15006            to send the pod's traffic to Envoy
# nf_tables, the compatibility layer for them (NFT_COMPAT) and NAT's redirect are in the stock config already.
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
# Marks, which Istio's DNS capture and its other interception modes use, and which a sidecar's rules may add in a later
# revision: they cost a few KiB and save a rebuild.
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
# sock_diag for TCP with SOCK_DESTROY: before a pod's VM pauses, its agent closes each TCP connection that leaves the
# guest, so that the kernel resets it to its peer.
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
