# The image and Rust that build the shim (scripts/build.sh) and the node's
# libkrun (node/libkrun/build.sh): rust:1.92-bookworm, which is Debian 12 with
# glibc 2.36 like the node, and Rust 1.99.1, which rustup installs into a cache
# in the smolvm checkout.
rust_image=rust@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2
rust_toolchain=1.99.1
